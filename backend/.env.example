# Copy to backend/.env.local. This file is a template, not a credential store.
# Values are literal: use KEY=value or KEY='value with spaces'.
# No variable interpolation, shell commands or inline comments are evaluated.

QWORK_HOST=0.0.0.0
QWORK_PORT=8787
# SQLite defaults to backend/data/qwork.sqlite3, regardless of the launch folder.
# Relative QWORK_DB paths are resolved from the backend folder.
# QWORK_DB=data/qwork.sqlite3
# Leave this unset to keep SQLite. Set it only when switching to PostgreSQL.
# QWORK_DATABASE_URL=postgresql://qwork:replace-with-password@localhost:5432/qwork

# Choose brevo or resend. Existing deployments default to resend when unset.
QWORK_EMAIL_PROVIDER=brevo
# Set all three values together to enable real verification/recovery emails.
# Brevo: API v3 key and the bare email address of a confirmed sender.
# Resend: API key and a sender permitted by your Resend account.
# Keep these server-only values out of mobile/.env.local and EXPO_PUBLIC_*.
QWORK_EMAIL_API_KEY=
QWORK_EMAIL_FROM=
# Public HTTPS origin of this Java API or its mail-only gateway.
# It must be reachable when opening email confirmation/recovery links.
QWORK_PUBLIC_URL=
